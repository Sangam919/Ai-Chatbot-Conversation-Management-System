# ==========================================
# Application & Environment Settings
# ==========================================
APP_NAME="AI Chatbot Conversation Management System"
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# ==========================================
# MongoDB Configuration
# ==========================================
# For local MongoDB Community edition:
MONGODB_URI=mongodb://127.0.0.1:27017
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=ai_chatbot_management

# ==========================================
# Authentication & Security
# ==========================================
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_32_byte_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# OpenAI & AI Provider Configuration
# ==========================================
# Supported providers: "openai", "fallback" (or "none")
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT=60
AI_MAX_OUTPUT_TOKENS=1500
MAX_HISTORY_MESSAGES=10
# Set to true if you explicitly want deterministic offline fallback when OpenAI is not configured or fails
ENABLE_OFFLINE_FALLBACK=true
